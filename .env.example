# ============================================================================
# Spotify Developer App Credentials (https://developer.spotify.com/dashboard)
# IMPORTANT: In your Spotify App Settings, add this exact Redirect URI:
#   http://127.0.0.1:8765/callback
# (Spotify bans "localhost" — you must use 127.0.0.1)
# ============================================================================
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback

# ============================================================================
# Ulanzi TC002 / AWTRIX NG Connection
# Use your clock's static LAN IP (recommended over .local mDNS inside Docker)
# ============================================================================
AWTRIX_HOST=192.168.1.50
AWTRIX_PORT=80
AWTRIX_USERNAME=
AWTRIX_PASSWORD=
AWTRIX_APP_NAME=spotify

# Automatically install/update the companion Berry script & server_url on boot
AUTO_INSTALL_SCRIPT=true

# ============================================================================
# Bridge HTTP Server Settings
# SERVER_LAN_URL must be reachable by your TC002 over Wi-Fi!
# Replace 192.168.1.100 with your always-on desktop's LAN IP address.
# ============================================================================
PORT=8765
SERVER_LAN_URL=http://192.168.1.100:8765
# Optional: on a PC with several networks, publish the bridge only on this address and
# 127.0.0.1. It must exist when the container starts, so reserve it on your router.
# BRIDGE_BIND_IP=192.168.1.100

# ============================================================================
# Display & Polling Tuning
# ============================================================================
POLL_ACTIVE_MS=2000
POLL_IDLE_MS=5000
PAUSE_GRACE_MS=6000
SWITCH_ON_TRACK_CHANGE=true
ASCII_TRANSLITERATE=true
LED_GAMMA=1.55
LED_SATURATION=1.25
